# Supabase PostgreSQL connection string (do not commit real values)
DATABASE_URL=

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Comma-separated allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (Next.js) — set in frontend/.env.local / Vercel (do not commit secrets)
NEXT_PUBLIC_API_URL=
